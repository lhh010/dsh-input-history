{
  "name": "@dsh-external/dsh-input-history",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Web 输入历史插件：Ctrl+Up / Ctrl+Down 像终端一样召回与切换已发送消息，零核心改动",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dshClient": {
    "inject": [
      "@deepseek-ai/dsh-client-runtime",
      "@deepseek-ai/dsh-client-ui-conversation"
    ],
    "platform": "web"
  },
  "files": [
    "lib",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-runtime": "file:../test-lhh010/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-conversation": "file:../test-lhh010/packages/client/ui-conversation",
    "@deepseek-ai/dsh-invariants": "file:../test-lhh010/packages/support/invariants",
    "cordis": "file:../test-lhh010/vendor/cordis",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "BSD-3-Clause"
}
